"Foreign rel. ener. food price, 100*log"        l_rp_enerstar
"Foreign rel. ener. food price, ann. QQ %"      dl_rp_enerstar
"Foreign rel. ener. food price, YY %"           d4l_rp_enerstar
"Foreign rel. ener. food price gap, %"          l_rp_enerstar_gap
